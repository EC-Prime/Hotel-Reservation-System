# Template for api/.env — copy this file to ".env" in the same folder
# and fill in the real values from your Aiven project Overview page.
#
#   cp .env.example .env
#
# ".env" itself must NEVER be committed — .gitignore already excludes it.
# This file IS committed, so it must never contain real credentials.

# Aiven hostname, e.g. hotel-reservation-db-xxxx.a.aivencloud.com
DB_HOST=
# Aiven assigns a random port (commonly 16659) — not the MySQL default 3306
DB_PORT=
# Aiven's default admin user
DB_USER=
# From the Aiven Overview page. Keep local to this project; never reuse.
DB_PASSWORD=
DB_NAME=hotel_reservation_system

# Path to the Aiven CA cert you downloaded, relative to the api/ folder
DB_SSL_CERT_PATH=./certs/ca.pem

# ----------------------------------------------------------------
# JWT Authentication — Web Guest Login System
# ----------------------------------------------------------------
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Then paste the output below. NEVER commit a real value to git.
JWT_SECRET=replace_with_a_long_random_string_at_least_64_chars

# How long tokens stay valid. Examples: 24h, 7d, 1h
JWT_EXPIRES_IN=24h
